        <definition>void ostk::physics::coordinate::frame::provider::CIRF::ComputeCIPCoordinates</definition>
        <argsstring>(const Real &amp;aModifiedJulianDate_TT, double &amp;x, double &amp;y, double &amp;s, const bool interpolate)</argsstring>
        <name>ComputeCIPCoordinates</name>
        <param>
          <type>const Real &amp;</type>
          <declname>aModifiedJulianDate_TT</declname>
        </param>
        <param>
          <type>double &amp;</type>
          <declname>x</declname>
