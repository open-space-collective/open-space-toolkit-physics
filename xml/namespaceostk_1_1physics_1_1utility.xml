        <type>String</type>
        <definition>String ostk::physics::utility::DoubleToString</definition>
        <argsstring>(double aValue, int aPrecision=-1)</argsstring>
        <name>DoubleToString</name>
        <param>
          <type>double</type>
          <declname>aValue</declname>
        </param>
        <param>
          <type>int</type>
          <declname>aPrecision</declname>
          <defval>-1</defval>
